<Window x:Class="Cajero.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cajero.UI"
        mc:Ignorable="d"
        Title="NEXUSBANK - Autenticación" 
        Height="620" Width="920" 
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="1.2*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <Border Width="100" Height="48" Background="{StaticResource AccentPrimaryBrush}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Text="NEXUSBANK" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BANCO DIGITAL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text="Sistema de Cajero Automático" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <TextBlock Text="Bienvenido al Cajero Automático" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Pase su tarjeta o ingrese sus datos de acceso para realizar operaciones bancarias seguras." 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,8,0,0" LineHeight="18"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentSuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Terminal en línea" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Border Background="{StaticResource BgCardBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="36,40" 
                        Width="420"
                        MaxWidth="460">

                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="Iniciar Sesión" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Ingrese sus credenciales de seguridad" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,24"/>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Token RFID / No. Tarjeta" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtRfidToken" Height="44" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="PIN de Seguridad (4 dígitos)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="pwdPin" MaxLength="6" Height="44" FontSize="15"/>
                        </StackPanel>

                        <TextBlock x:Name="lblMensajeEstado" 
                                   Text="" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource AccentDangerBrush}" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,16" 
                                   Visibility="Collapsed"/>

                        <Button x:Name="btnLogin" 
                                Content="Ingresar al Cajero" 
                                Height="46" 
                                Style="{StaticResource PrimaryButton}" 
                                Click="BtnLogin_Click" 
                                Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

    </Grid>
</Window>