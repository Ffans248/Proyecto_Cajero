<Window x:Class="Cajero.UI.CambioPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambio de PIN de Seguridad" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">

    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="20" Padding="20">
        <StackPanel>
            <TextBlock Text="Actualizar PIN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Ingrese su PIN actual y el nuevo código." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,20"/>

            <TextBlock Text="PIN Actual (4 dígitos):" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPinActual" Height="36" FontSize="16" MaxLength="4" Margin="0,0,0,15" HorizontalContentAlignment="Center"/>

            <TextBlock Text="Nuevo PIN (4 dígitos):" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPinNuevo" Height="36" FontSize="16" MaxLength="4" Margin="0,0,0,20" HorizontalContentAlignment="Center"/>

            <Button Content="Confirmar Cambio" Style="{StaticResource PrimaryButton}" Height="40" Click="BtnConfirmar_Click"/>
        </StackPanel>
    </Border>
</Window>