<Window x:Class="Cajero.UI.CambioPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambio de PIN de Seguridad" 
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">

    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Text="Actualizar Clave PIN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Ingrese sus credenciales y el token para autorizar el cambio." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,16"/>

            <!-- Token Generado -->
            <Border Background="{StaticResource BgCardLighterBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Token de seguridad generado: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblTokenGenerado" Text="1234" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="PIN Actual (4 dígitos):" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtPinActual" Height="36" FontSize="16" MaxLength="4" Margin="0,0,0,12" HorizontalContentAlignment="Center"/>

            <TextBlock Text="Token de Autorización (4 dígitos):" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtToken" Height="36" FontSize="16" MaxLength="4" Margin="0,0,0,12" TextAlignment="Center"/>

            <TextBlock Text="Nuevo PIN (4 dígitos):" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtPinNuevo" Height="36" FontSize="16" MaxLength="4" Margin="0,0,0,12" HorizontalContentAlignment="Center"/>

            <TextBlock Text="Confirmar Nuevo PIN (4 dígitos):" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtPinConfirmar" Height="36" FontSize="16" MaxLength="4" Margin="0,0,0,20" HorizontalContentAlignment="Center"/>

            <Button Content="Confirmar Cambio de PIN" Style="{StaticResource PrimaryButton}" Height="42" Click="BtnConfirmar_Click"/>
        </StackPanel>
    </Border>
</Window>
