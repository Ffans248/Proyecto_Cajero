<Window x:Class="Cajero.UI.RetiroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retiro de Efectivo" 
        Height="680" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Retiro con Desglose Manual" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Ingrese la cantidad de billetes deseada para cada denominación y valide con su PIN y Token." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Banner de Token y Validación de Seguridad -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Token Generado al vuelo -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BgCardLighterBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Token de seguridad generado para este retiro: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblTokenGenerado" Text="1234" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Input PIN (4 dígitos) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="PIN de Seguridad (4 dígitos):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pwdPin" MaxLength="4" Height="38" FontSize="16" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Input Token (4 dígitos) -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Ingresar Token de Autorización (4 dígitos):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTokenIngresado" MaxLength="4" Height="38" FontSize="16" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario de Billetes (Todas las 7 denominaciones oficiales) -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda (Billetes Altos) -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q200:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ200" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q100:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ100" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q50:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ50" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q20:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ20" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                </StackPanel>

                <!-- Columna Derecha (Billetes Pequeños y Q1) -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q10:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ10" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q5:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ5" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Billetes de Q1:" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtQ1" Width="80" Padding="0" Height="38" FontSize="15" VerticalContentAlignment="Center" Text="0" TextAlignment="Center" TextChanged="CalcularTotal_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resumen y Botones -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Total a Retirar:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="lblTotal" Text="Q 0.00" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancelar" Style="{StaticResource OutlineButton}" Width="100" Height="42" Margin="0,0,12,0" Click="BtnCancelar_Click"/>
                <Button Content="Confirmar Retiro" Style="{StaticResource PrimaryButton}" Width="150" Height="42" Click="BtnConfirmar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
