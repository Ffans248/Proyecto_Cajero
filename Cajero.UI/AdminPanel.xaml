<Window x:Class="Cajero.UI.AdminPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cajero.UI"
        mc:Ignorable="d"
        Title="NEXUSBANK - Panel de Administración" 
        Height="720" Width="1140"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="NEXUSBANK - Panel de Administración" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Gestion de usuarios y auditoría de transacciones." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cerrar Panel" Style="{StaticResource OutlineButton}" Padding="14,8" Click="BtnCerrar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8,8,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Pestaña 1: Gestión de Usuarios -->
            <TabItem Header="Gestión de Usuarios">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Registrar Nuevo Usuario -->
                    <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Registrar Nuevo Usuario" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Ingrese los datos requeridos para dar de alta al cliente." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Número de Tarjeta (16 dígitos)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtTarjeta" Height="42" FontSize="14" MaxLength="16"/>
                                </StackPanel>
                                
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Nombre Completo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNombre" Height="42" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="PIN de Seguridad (4 dígitos)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="pwdNuevoPin" MaxLength="6" Height="42" FontSize="15"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Límite Diario de Retiro" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtLimite" Height="42" FontSize="14"/>
                                </StackPanel>

                                <TextBlock x:Name="lblEstadoRegistro" 
                                           Text="" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource AccentSuccessBrush}" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,16" 
                                           Visibility="Collapsed"/>

                                <Button x:Name="btnRegistrarUsuario" 
                                        Content="Registrar Usuario" 
                                        Style="{StaticResource SuccessButton}" 
                                        Height="44" 
                                        Click="BtnRegistrarUsuario_Click" 
                                        Margin="0,0,0,10"/>

                                <Button x:Name="btnLimpiarCampos" 
                                        Content="Limpiar Campos" 
                                        Style="{StaticResource OutlineButton}" 
                                        Height="46" 
                                        Click="BtnLimpiarCampos_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Modificar Usuario -->
                    <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Modificar Usuario" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Busque un usuario por tarjeta y modifique sus datos." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Buscar Tarjeta" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtBuscarTarjetaMod" Height="42" FontSize="14" MaxLength="16" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource OutlineButton}" Padding="16,0" Height="42" Click="BtnBuscarUsuarioMod_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="panelModificarUsuario" Visibility="Collapsed">
                                    <TextBlock x:Name="lblNombreUsuarioMod" Text="Nombre: " FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Nuevo PIN (Opcional, 4 dígitos)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="pwdPinMod" MaxLength="6" Height="42" FontSize="15"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="Nuevo Límite Diario" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtLimiteMod" Height="42" FontSize="14"/>
                                    </StackPanel>

                                    <TextBlock x:Name="lblEstadoModificacion" 
                                               Text="" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               TextWrapping="Wrap" 
                                               Margin="0,0,0,16" 
                                               Visibility="Collapsed"/>

                                    <Button x:Name="btnGuardarCambios" 
                                            Content="Guardar Cambios" 
                                            Style="{StaticResource PrimaryButton}" 
                                            Height="44" 
                                            Click="BtnGuardarCambios_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Pestaña 2: Bóveda y Stock -->
            <TabItem Header="Bóveda y Stock">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Control de Stock Actual -->
                    <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Control de Stock" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Billetes actualmente disponibles en el cajero." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ListView Grid.Row="1" x:Name="lvStockBoveda" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DenominacionFormat}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CantidadFormat}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SubtotalFormat}" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Grid.Row="2" Background="{StaticResource BgCardLighterBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total en Bóveda: " FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblTotalBoveda" Text="Q 0.00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Agregar Lote de Billetes -->
                    <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Agregar Lote de Billetes" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Ingrese la cantidad de billetes a cargar en la bóveda." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Q200 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Q 200:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRecarga200" Height="42" FontSize="14" Margin="0,0,0,12" Text="0"/>

                                    <!-- Q100 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Q 100:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtRecarga100" Height="42" FontSize="14" Margin="0,0,0,12" Text="0"/>

                                    <!-- Q50 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Q 50:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtRecarga50" Height="42" FontSize="14" Margin="0,0,0,12" Text="0"/>

                                    <!-- Q20 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Q 20:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,12"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtRecarga20" Height="42" FontSize="14" Margin="0,0,0,12" Text="0"/>

                                    <!-- Q10 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Q 10:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,12"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtRecarga10" Height="42" FontSize="14" Margin="0,0,0,12" Text="0"/>

                                    <!-- Q5 -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Q 5:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,12"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtRecarga5" Height="42" FontSize="14" Margin="0,0,0,12" Text="0"/>
                                </Grid>

                                <TextBlock x:Name="lblEstadoRecarga" 
                                           Text="" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,16" 
                                           Visibility="Collapsed"/>

                                <Button x:Name="btnProcesarRecarga" 
                                        Content="Procesar Recarga" 
                                        Style="{StaticResource SuccessButton}" 
                                        Height="44" 
                                        Click="BtnProcesarRecarga_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Pestaña 3: Auditoría de Transacciones -->
            <TabItem Header="Auditoría de Transacciones">
                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Control de Transacciones Diarias" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Registro de movimientos procesados en este cajero." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    x:Name="btnActualizarTransacciones" 
                                    Content="Refrescar Lista" 
                                    Style="{StaticResource OutlineButton}" 
                                    Padding="12,6" 
                                    FontSize="12"
                                    Click="BtnActualizarTransacciones_Click"/>
                        </Grid>

                        <DataGrid Grid.Row="1" 
                                  x:Name="dgTransacciones"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource BgPrimaryBrush}"
                                  RowBackground="{StaticResource BgCardBrush}"
                                  AlternatingRowBackground="{StaticResource BgCardLighterBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  FontSize="13"
                                  RowHeight="36">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaHora}" Width="150"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="140"/>
                                <DataGridTextColumn Header="Operación" Binding="{Binding TipoOperacion}" Width="130"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding MontoFormateado}" Width="100"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                        <Border Grid.Row="2" Background="{StaticResource BgPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NEXUSBANK Core - Transacciones en tiempo real" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="lblTotalTransacciones" Text="Total de registros: 0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>